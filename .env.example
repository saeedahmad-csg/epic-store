# APEXSTORE AI SUPPORT AGENT ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Google Gemini API (Required for live AI agent responses)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Model: gemini-flash-lite-latest (fastest latency with native function calling)
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_THINKING_BUDGET=0

# 2. Operations & Admin Authentication (Strict Mode: Required for /admin portal)
ADMIN_EMAIL="admin@apexstore.com"
ADMIN_PASSWORD="replace-with-a-secure-admin-password"
ADMIN_SECRET_KEY="replace-with-a-random-secret-key"

# 3. Google Cloud Service Account for Google Sheets (Strict Mode)
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Share your Google Sheet with this email address as Editor!
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-gcp-project.iam.gserviceaccount.com"

# The RSA private key from your service account JSON file.cx
# Note: Ensure newlines are formatted as \n wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# The Google Sheet ID from your spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID="your-google-sheet-id"

# 4. Optional SMTP Configuration for Live Email Delivery
# If omitted or left as placeholder, receipts are safely recorded and previewed in Admin Email Viewer!
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="support@yourdomain.com"
SMTP_PASS="your-app-password"
SMTP_FROM="\"ApexStore Customer Support\" <support@yourdomain.com>"
